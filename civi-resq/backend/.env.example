# CIVI-RESQ Backend Configuration
# Copy this file to .env and fill in real values before running in production.

# --- Database ---
DATABASE_URL=postgresql://civiresq:civiresq_pass@localhost:5433/civiresq_db

# --- Auth ---
# Generate a real secret with: openssl rand -hex 32
SECRET_KEY=CHANGE_THIS_IN_PRODUCTION_use_openssl_rand_hex_32

# --- App ---
ENV=development
DEBUG=true
